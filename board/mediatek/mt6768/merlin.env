stdin=serial,button-kbd,mtk-keypad
stdout=serial,vidconsole
stderr=serial,vidconsole

bootdelay=0
boot_profile=dev

set_dev=setenv boot_profile dev; saveenv; echo "Switched to development profile"; reset
set_normal=setenv boot_profile normal; saveenv; echo "Switched to normal profile"; reset

bootcmd_dev=echo "=> SLOWBOOT mode..."; fastboot usb 0; bootmenu
bootcmd_normal=bootmenu

bootcmd=run bootcmd_${boot_profile}

bootcmd_linux=bootflow scan -b
bootcmd_sd=bootflow scan -b mmc1
do_ums_emmc=echo "=> UMS eMMC mode"; ums 0 mmc 0
do_ums_sd=echo "=> UMS microSD mode"; ums 0 mmc 1
do_usbacm=setenv stdin serial,button-kbd,mtk-keypad,usbacm; setenv stdout serial,vidconsole,usbacm; setenv stderr serial,vidconsole,usbacm; echo "=> USB ACM mode"
do_fastboot=echo "=> SLOWBOOT mode..."; fastboot usb 0

bootmenu_delay=10
bootmenu_top=10
bootmenu_left=10
bootmenu_0=Boot Linux (eMMC)=run bootcmd_linux
bootmenu_1=Boot Linux (microSD)=run bootcmd_sd
bootmenu_2=UMS eMMC=run do_ums_emmc
bootmenu_3=UMS microSD=run do_ums_sd
bootmenu_4=USB ACM=run do_usbacm
bootmenu_5=Fastboot mode=run do_fastboot
bootmenu_6=Switch to development mode=run set_dev
bootmenu_7=Switch to normal mode=run set_normal
bootmenu_8=Reboot=reset
bootmenu_9=Power off=poweroff

button_cmd_0_name=Home Button
button_cmd_0=bootmenu
